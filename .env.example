# Hostinger Node.js environment variables for Email to agent.
# Copy the names into the hosting panel. Do not commit real values.
# Mailbox: agent@freemedicaretools.com (smtp.hostinger.com, port 465, SSL).
# Port 587 needs SMTP_SECURE=false.

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=agent@freemedicaretools.com
SMTP_PASSWORD=

# Optional. Defaults to SMTP_USER, then agent@freemedicaretools.com.
WORKSHEET_EMAIL_FROM=agent@freemedicaretools.com
WORKSHEET_AGENT_EMAIL=agent@freemedicaretools.com

# PRODUCTION: leave WORKSHEET_EMAIL_TO unset.
# Never point it at a personal inbox, including a personal Gmail address, for real
# worksheet information. If it is set while NODE_ENV=production, the server refuses
# to send unless WORKSHEET_EMAIL_PREVIEW=true is also set on a preview host.
# WORKSHEET_EMAIL_TO=
# WORKSHEET_EMAIL_PREVIEW=

# Set true only when the host proxy replaces X-Forwarded-For (Hostinger).
# Otherwise the server ignores X-Forwarded-For and X-Real-IP.
# WORKSHEET_TRUST_PROXY=
